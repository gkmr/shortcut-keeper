  "rules": [
    {
      "id": "hyper-key",
      "text": "Caps Lock is the Hyper key (Raycast, include Shift on)",
      "check": {
        "by": "raycast_hyper"
      },
      "policy": "enforce",
      "gk_fix": "Raycast Settings > Keyboard > Hyper Key: Caps Lock, include Shift"
    },
    {
      "id": "spotlight-off",
      "text": "Spotlight ⌘Space stays off (so ⌘Space is free)",
      "check": {
        "by": "symbolic",
        "id": "64",
        "enabled": false
      },
      "policy": "watch"
    },
    {
      "id": "wispr-no-left-ctrl",
      "text": "Wispr Flow must not use left Control (it fired on every ⌃⌥ and Caps chord) or ⌃Space (Raycast owns it)",
      "check": {
        "by": "wispr_absent",
        "codes": [
          "59",
          "49+59"
        ]
      },
      "policy": "enforce"
    },
    {
      "id": "screenshots-location",
      "text": "Screenshots and recordings save to ~/Pictures/Screenshots",
      "check": {
        "by": "defaults",
        "domain": "com.apple.screencapture",
        "key": "location-screenshot",
        "equals": "~/Pictures/Screenshots"
      },
      "policy": "enforce"
    },
    {
      "id": "rect-panel",
      "text": "Rectangle snap panel shows the Key Deck Windows tiles in the same order (one source: keys.json)",
      "check": {
        "by": "rect_panel_sync"
      },
      "policy": "enforce"
    },
    {
      "id": "gemini-quiet",
      "text": "Gemini mini chat and Speak to Window stay off (they used ⌥Space and Fn; Fn belongs to Wispr)",
      "check": {
        "by": "gemini_ax",
        "expect": {
          "Mini chat keyboard shortcut": "None",
          "Tap to speak keyboard shortcut": "None",
          "Hold while speaking keyboard shortcut": "None"
        }
      },
      "policy": "enforce"
    },
    {
      "id": "keydeck-running",
      "text": "Key Deck is running (Caps / overlay, Caps W Webcam Mode)",
      "check": {
        "by": "launchd",
        "label": "com.example.keydeck",
        "plist": "~/Library/LaunchAgents/com.example.keydeck.plist"
      },
      "policy": "enforce"
    },
    {
      "id": "no-interceptor",
      "policy": "watch",
      "text": "No driver-level key remapper (Karabiner-Elements) taking Caps Lock before Raycast's Hyper Key",
      "gk_fix": "Keep one Hyper key: Raycast's, or Karabiner's with Raycast's Hyper Key set to None",
      "check": {
        "by": "no_interceptor",
        "apps": [
          "/Applications/Karabiner-Elements.app"
        ],
        "procs": [
          "karabiner_grabber",
          "Karabiner-Core-Service"
        ]
      }
    },
    {
      "id": "secure-input",
      "policy": "report",
      "text": "Times an app in the background held secure input and paused the Caps keys (report only)",
      "check": {
        "by": "log_errors",
        "path": "~/Projects/shortcut-keeper/.state/keydeck.log",
        "hours": 168,
        "pattern": "secure input held by"
      }
    }
  ],
  "fixers": {
    "wispr_required": {
      "63": "ptt",
      "62": "ptt",
      "49+63": "popo"
    },
    "betterwispr_shortcut": {
      "key": "B",
      "keyCode": 11,
      "modifiers": 6912
    },
    "rectangle": {
      "topCenterSixth": {
        "type": 0,
        "keyCode": 16,
        "modifierFlags": 1966080
      },
      "almostMaximize": {
        "type": 0,
        "keyCode": 8,
        "modifierFlags": 786432
      }
    }
  },
  "acknowledged_reserved": [
    "cmd+`",
    "cmd+space",
    "ctrl+space",
    "shift+cmd+/",
    "shift+cmd+3",
    "shift+cmd+4",
    "shift+cmd+5"
  ],
  "ignore": [
    {
      "owner": "Logi Options+",
      "action": "gesture click",
      "why": "the gesture click opens the Actions Ring; it sends no key"
    }
  ],
  "deck_theme": "auto",
